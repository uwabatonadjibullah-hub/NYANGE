# Optional: Firebase App Check (reCAPTCHA Enterprise) site key.
# When set, the public site attaches App Check tokens to Firestore requests.
# After confirming tokens arrive, enforce App Check for Firestore in the Firebase console.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only. When "true", the app uses the Firebase emulators
# (npm run emulators) instead of the real project. Never set this for production builds.
VITE_FIREBASE_EMULATOR=
