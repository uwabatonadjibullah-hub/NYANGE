{
  "entities": {
    "descendantSubmission": {
      "title": "DescendantSubmission",
      "description": "Community census submission proposing descendants or corrections for the family registry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the submission",
          "maxLength": 128
        },
        "parentId": {
          "type": "string",
          "description": "The ID of the parent person this submission connects to",
          "maxLength": 128
        },
        "parentName": {
          "type": "string",
          "description": "The name of the parent person",
          "maxLength": 200
        },
        "parentGenerationLevel": {
          "type": "number",
          "description": "Generational level of the parent (0-5)"
        },
        "branchId": {
          "type": "string",
          "description": "The branch ID of the family",
          "maxLength": 128
        },
        "branchName": {
          "type": "string",
          "description": "The human-readable branch name",
          "maxLength": 200
        },
        "children": {
          "type": "array",
          "description": "List of proposed child records to append to the registry"
        },
        "contributorName": {
          "type": "string",
          "description": "Full name of the submitting family member",
          "maxLength": 200
        },
        "contributorContact": {
          "type": "string",
          "description": "Contact phone or email of the submitter",
          "maxLength": 200
        },
        "relationshipExplanation": {
          "type": "string",
          "description": "Relationship to the parent person or family",
          "maxLength": 500
        },
        "additionalNotes": {
          "type": "string",
          "description": "Additional genealogical context or sources",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "description": "Status of the census submission",
          "enum": ["pending_approval", "approved", "rejected", "requires_clarification"]
        },
        "submittedAt": {
          "type": "string",
          "description": "ISO timestamp of when submission was created",
          "maxLength": 50
        },
        "reviewedAt": {
          "type": "string",
          "description": "ISO timestamp when submission was reviewed",
          "maxLength": 50
        },
        "reviewedBy": {
          "type": "string",
          "description": "Name or identifier of the reviewer",
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "parentId",
        "parentName",
        "branchId",
        "branchName",
        "children",
        "status",
        "submittedAt"
      ]
    },
    "recordMeNotification": {
      "title": "RecordMeNotification",
      "description": "Urgent family notices, tragedy notifications, and new member registrations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Receipt ID of the notification",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Category of notice",
          "enum": ["tragedy", "urgent_notice", "new_member"]
        },
        "senderName": {
          "type": "string",
          "description": "Name of sender",
          "maxLength": 200
        },
        "senderContact": {
          "type": "string",
          "description": "Contact info of sender",
          "maxLength": 200
        },
        "affectedName": {
          "type": "string",
          "description": "Name of affected person for tragedy reports",
          "maxLength": 200
        },
        "branchId": {
          "type": "string",
          "description": "Branch ID",
          "maxLength": 128
        },
        "fatherName": {
          "type": "string",
          "description": "Father name",
          "maxLength": 200
        },
        "motherName": {
          "type": "string",
          "description": "Mother name",
          "maxLength": 200
        },
        "generationLevel": {
          "type": "string",
          "description": "Generation level label",
          "maxLength": 50
        },
        "connectionStory": {
          "type": "string",
          "description": "Connection details",
          "maxLength": 2000
        },
        "subject": {
          "type": "string",
          "description": "Subject line",
          "maxLength": 300
        },
        "details": {
          "type": "string",
          "description": "Message details",
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "description": "Verification status",
          "maxLength": 50
        },
        "submittedAt": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "type",
        "senderName",
        "senderContact",
        "details",
        "status",
        "submittedAt"
      ]
    },
    "admin": {
      "title": "Admin",
      "description": "Admin record designating family council reviewers",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "description": "Role level",
          "enum": ["superadmin", "council_reviewer"]
        },
        "addedAt": {
          "type": "string",
          "description": "ISO timestamp when admin was added",
          "maxLength": 50
        }
      },
      "required": ["email", "role"]
    },
    "testDoc": {
      "title": "TestDocument",
      "description": "Health check document to verify connection to Firestore",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Status of connection",
          "maxLength": 50
        }
      }
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "descendantSubmission",
      "description": "Collection of community census submissions"
    },
    "/notifications/{notificationId}": {
      "schema": "recordMeNotification",
      "description": "Collection of emergency notifications and record-me submissions"
    },
    "/admins/{userId}": {
      "schema": "admin",
      "description": "Collection of authorized council administrators"
    },
    "/test/{docId}": {
      "schema": "testDoc",
      "description": "Connection test collection"
    }
  }
}
